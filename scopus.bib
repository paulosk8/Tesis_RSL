@ARTICLE{Cayres2020213,
	author = {Cayres, Leandro Ungari and de Lima, Bruno Santos and Garcia, Rogério Eduardo and Correia, Ronaldo Celso Messias},
	title = {Analysis of node.js application performance using mongoDB drivers},
	year = {2020},
	journal = {Advances in Intelligent Systems and Computing},
	volume = {1137 AISC},
	pages = {213 - 222},
	doi = {10.1007/978-3-030-40690-5_21},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85080862767&doi=10.1007%2F978-3-030-40690-5_21&partnerID=40&md5=71633867e4026d9b05bb1b2b35a4171e},
	affiliations = {Faculty of Science and Technology, São Paulo State University (UNESP), Presidente Prudente, SP, Brazil},
	abstract = {At the last few years, the usage of NoSQL databases has increased, and consequently, the need for integrating with different programming languages. In that way, database drivers provide an API to perform database operations, which may impact on the performance of applications. In this article, we present a comparative study between two main drivers solutions to MongoDB in Node.js, through the evaluation of CRUD tests based on quantitative metrics (time execution, memory consumption, and CPU usage). Our results show which, under quantitative analysis, the MongoClient driver has presented a better performance than Mongoose driver in the considered scenarios, which may imply as the best alternative in the development of Node.js applications. © Springer Nature Switzerland AG 2020.},
	author_keywords = {Drivers; MongoDB; Node.js application; NoSQL databases; Performance},
	keywords = {Computer programming; Computer science; Truck drivers; Application performance; Comparative studies; Memory consumption; MongoDB; Nosql database; Performance; Quantitative metrics; Graph Databases},
	correspondence_address = {L.U. Cayres; Faculty of Science and Technology, São Paulo State University (UNESP), Presidente Prudente, Brazil; email: leandro.ungari@unesp.br},
	editor = {Rocha A. and Ferrás C. and Montenegro Marin C.E. and Medina García V.H.},
	publisher = {Springer},
	issn = {21945357},
	isbn = {978-303040689-9},
	language = {English},
	abbrev_source_title = {Adv. Intell. Sys. Comput.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Raikar2024,
	author = {Raikar, Meenaxi M and Patil, Priyadarshini and Guggari, Shankru and Shavi, Prajwal and Mudavi, Swati and Patil, Neha and Rangannavar, Viju},
	title = {Leveraging Docker Containers for Deployment of Web Applications in Microservices Architecture},
	year = {2024},
	journal = {2024 1st International Conference for Women in Computing, InCoWoCo 2024 - Proceedings},
	pages = {},
	doi = {10.1109/InCoWoCo64194.2024.10863683},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218335969&doi=10.1109%2FInCoWoCo64194.2024.10863683&partnerID=40&md5=a9982034b2260d0f5968f0fb339b1909},
	affiliations = {School of Computer Science and Engineering, K. L. e Technological University, Hubballi, India},
	abstract = {The increasing demand for scalable, flexible, and efficient web applications has led to adopting microservices architectures. Docker containers, in conjunction with microservices, enable seamless deployment and management of web applications. This paper explores the integration of Docker and microservices architecture for developing scalable web applications. Docker's containerization Technology enables packaging applications and related dependencies to be integrated into portable containers, providing advantages such as rapid startup times, reduced resource consumption, and flexible deployment options. This study highlights the use of Docker in a microservices framework, encompassing components such as client applications, Docker containers, microservices, and the database layer. The proposed system leverages Docker to develop a web application with Angular for the front end and Node.js for the back end, deployed on the Google Cloud Platform (GCP). The key aspects of the implementation include SSL/TLS configuration for secure communication, the use of middleware for authentication and session management, and a robust database connection setup with MongoDB and Mongoose. Performance analysis compares Docker containers with traditional virtual machines, demonstrating superior resource efficiency and faster deployment times.  © 2024 IEEE.},
	author_keywords = {Container; Docker; GCP; Microservices; MongoDB},
	keywords = {Authentication; Plastic bottles; Secure communication; Virtual machine; Cloud platforms; Docker; Google cloud platform; Google+; Microservice; MongoDB; Packaging applications; Rapid startups; WEB application; Web applications; Middleware},
	correspondence_address = {M.M. Raikar; School of Computer Science and Engineering, K. L. e Technological University, Hubballi, India; email: mmraikar@kletech.ac.in},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151894-3},
	language = {English},
	abbrev_source_title = {Int. Conf. Women Comput., InCoWoCo - Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Subbulakshmi2024113,
	author = {Subbulakshmi, N. and Begum, S. Ariffa and Vignesh, R. Venkata and Chandru, R.},
	title = {Asynchronous Event Driven Brain Teaser Using Node.js},
	year = {2024},
	journal = {5th International Conference on Electronics and Sustainable Communication Systems, ICESC 2024 - Proceedings},
	pages = {113 - 118},
	doi = {10.1109/ICESC60852.2024.10689905},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206668450&doi=10.1109%2FICESC60852.2024.10689905&partnerID=40&md5=6a52c022d889f8bcacf77656d05785a5},
	affiliations = {School of Computing, Kalsalingam Academy of Research and Education, Virudhunagar, India; Sri Ramakrishna Engineering College, Electronics and Communication Engineering, India},
	abstract = {Node.js has emerged as a powerful platform for building scalable and efficient backend applications. This research study provides a comprehensive overview of Node.js development, encompassing its core concepts, asynchronous programming paradigms, and essential tools. This study analyzes the fundamentals of Node.js, including event-driven architecture, asynchronous operations, and package management using npm. Database integration is explored through popular ORMs like Mongoose and Sequelize for MongoDB and MySQL, respectively and also highlights the significance of authentication and authorization using Passport.js and JWT. To ensure application quality, effective testing and debugging strategies using frameworks such as Mocha, Chai, and Jest are also reviewed. By combining these elements, developers can create robust and high-performance Node.js applications.  © 2024 IEEE.},
	author_keywords = {Artificial Intelligence; Machine Learning; Music Recommendation system},
	keywords = {Computer debugging; Asynchronous event; Asynchronous operation; Asynchronous programming; Brain teasers; Event-driven; Event-driven architectures; Machine-learning; Music Recommendation System; Programming paradigms; Research studies; Program debugging},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835037994-5},
	language = {English},
	abbrev_source_title = {Int. Conf. Electron. Sustain. Commun. Syst., ICESC - Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

